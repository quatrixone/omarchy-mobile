# Omarchy Mobile's Dipper-only Freedreno DRI driver.
# Based on Arch Linux's Mesa PKGBUILD, tag 1-26.2.4-1 (0BSD).
pkgname=mesa-freedreno-dipper
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
epoch=1
_pkgver=${pkgver/[a-z]/-&}
_mesa_pkgrel=1.4
_omamobile=omamobile4
pkgdesc="Freedreno DRI driver for the Xiaomi Mi 8"
arch=(aarch64)
url="https://www.mesa3d.org/"
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
depends=("mesa=$epoch:$pkgver-$_mesa_pkgrel")
makedepends=(
  clang expat glibc libdisplay-info libdrm libelf libgcc libglvnd libva
  libx11 libxcb libxext libxml2 libxrandr libxshmfence libxxf86vm llvm
  llvm-libs lm_sensors spirv-llvm-translator spirv-tools systemd-libs
  vulkan-icd-loader wayland xcb-util-keysyms zlib zstd cmake elfutils
  glslang libclc meson python-mako python-packaging python-ply
  python-pycparser python-yaml wayland-protocols xorgproto
)
options=(!lto)
source=(
  "https://archive.mesa3d.org/mesa-$_pkgver.tar.xz"
  "https://archive.mesa3d.org/mesa-$_pkgver.tar.xz.sig"
  0001-panfrost-add-Mali-G710-to-the-model-table.patch
  0002-panfrost-don-t-make-image-BOs-private-on-panthor.patch
  0003-panfrost-Advertise-Mali-G68-support.patch
  0004-panfrost-add-Mali-G78-to-the-model-table.patch
  0005-panfrost-backport-upstream-Mali-G715-model.patch
  0006-pan-csf-backport-NOP-payload-type.patch
  0007-pan-genxml-backport-v11-XML.patch
  0008-panfrost-backport-shared-v11-build-support.patch
  0009-panfrost-backport-v11-Gallium-support.patch
  0010-panvk-backport-v11-support.patch
)
validpgpkeys=(
