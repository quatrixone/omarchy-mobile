prepare() {
  cd "mesa-$_pkgver"
  local src
  for src in "${source[@]}"; do
    src=${src##*/}
    [[ $src == *.patch ]] || continue
    patch --fuzz=0 -Np1 < "../$src"
  done
  echo "$_pkgver-arch$epoch.$_mesa_pkgrel.$_omamobile" > VERSION
}

build() {
  arch-meson "mesa-$_pkgver" build \
    --optimization 2 \
    -D android-libbacktrace=disabled \
    -D b_ndebug=true \
    -D gallium-drivers=freedreno \
    -D gallium-extra-hud=true \
    -D gallium-mediafoundation=disabled \
    -D gallium-rusticl=false \
    -D gallium-va=disabled \
    -D gles1=disabled \
    -D html-docs=disabled \
    -D libunwind=disabled \
    -D microsoft-clc=disabled \
    -D valgrind=disabled \
    -D video-codecs=all \
    -D vulkan-drivers=[] \
    -D vulkan-layers=[] \
    -D vulkan-loader-rpath= \
    -D vulkan-manifest-per-architecture=false
  meson compile -C build
}

check() {
  "$startdir/test/all"
}

package() {
  local staging
  staging=$(mktemp -d)
  trap 'rm -rf "$staging"' RETURN
  meson install -C build --destdir "$staging" --no-rebuild
  local driver=$staging/usr/lib/dri/msm_dri.so
  [[ -f $driver ]] || { echo "Freedreno did not install msm_dri.so" >&2; return 1; }
  install -Dm755 "$driver" "$pkgdir/usr/lib/dri/msm_dri.so"
  install -Dm644 "mesa-$_pkgver/docs/license.rst" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
